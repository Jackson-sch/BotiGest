# Base de Datos PostgreSQL / PgBouncer
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=botica_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
# En producción usar SSL: postgresql://user:pass@host:5432/botica_db?sslmode=require
DATABASE_URL=postgresql://postgres:root@localhost:5433/botica_db

# Seguridad de Autenticación & Sesión (JWT / HMAC SHA-256)
# Generar una clave de alta entropía (mínimo 32 caracteres): openssl rand -base64 32
AUTH_SECRET=genera_una_clave_secreta_super_segura_de_32_caracteres_o_mas

# Facturación Electrónica SUNAT (UBL 2.1 - Perú)
SUNAT_ENV=beta
SUNAT_RUC=20123456789
# API Propia en la nube:
SUNAT_API_URL=https://sunat-billing-api.vercel.app
SUNAT_API_KEY=sk_live_tu_clave_de_empresa_aqui
# O pasarela PSE alterna (opcional):
SUNAT_PSE_URL=https://api.nubefact.com/api/v1/tu-token-o-endpoint
SUNAT_PSE_TOKEN=tu_token_de_facturacion_pse_aqui

# Supabase (Opcional si se usa storage o auth gestionado)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_aqui
